# ─────────────────────────────────────────────
# Fastlane ortam değişkenleri — ÖRNEK
# Lokalde test için: bu dosyayı kopyala → android/fastlane/.env ve ios/fastlane/.env
# CI'da bunlar GitHub Secrets'tan gelir (bkz .github/workflows/main.yml)
# BU DOSYAYI gerçek değerlerle DOLDURUP repoya COMMIT ETME (.env gitignore'da)
# ─────────────────────────────────────────────

# ===== ANDROID =====
ANDROID_KEYSTORE_PATH=/absolute/path/to/release.keystore
ANDROID_KEYSTORE_PASSWORD=keystore_sifresi
ANDROID_KEY_ALIAS=upload
ANDROID_KEY_PASSWORD=key_sifresi

# Firebase App Distribution
FIREBASE_ANDROID_APP_ID=1:1234567890:android:abcdef123456
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/firebase-service-account.json
FIREBASE_TESTER_GROUPS=beta-testers

# Google Play (deploy lane'i için)
GOOGLE_PLAY_JSON_KEY_PATH=/absolute/path/to/play-service-account.json

# ===== iOS =====
IOS_BUNDLE_ID=com.yemekimnerede.app
APPLE_TEAM_ID=ABCDE12345
APPLE_ID=ornek@mail.com

# App Store Connect API Key (.p8 içeriği base64'lenmiş)
APP_STORE_CONNECT_API_KEY_ID=ABC123DEF4
APP_STORE_CONNECT_API_ISSUER_ID=69a6de7e-xxxx-xxxx-xxxx-xxxxxxxxxxxx
APP_STORE_CONNECT_API_KEY_CONTENT=base64_p8_icerigi

# fastlane match (sertifika deposu)
MATCH_GIT_URL=https://github.com/<kullanici>/certificates.git
MATCH_PASSWORD=match_sifresi
# Sertifika reposu private ise (kullanici:PAT base64'lenmiş):
MATCH_GIT_BASIC_AUTHORIZATION=base64(kullanici:github_pat)
